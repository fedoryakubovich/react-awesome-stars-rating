{
  "name": "react-awesome-stars-rating",
  "version": "0.0.0-development",
  "description": "Accessible star rating component for React, with half stars, keyboard control and any scale or palette.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "unpkg": "./dist/index.umd.cjs",
  "jsdelivr": "./dist/index.umd.cjs",
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "react-component",
    "star-rating",
    "stars-rating",
    "rating",
    "rating-component",
    "stars",
    "star",
    "half-star",
    "review",
    "feedback",
    "accessibility",
    "a11y",
    "typescript",
    "ui-component"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedoryakubovich/react-awesome-stars-rating.git"
  },
  "homepage": "https://react-awesome-stars-rating-orpin.vercel.app/",
  "author": "Fedor Yakubovich",
  "bugs": {
    "url": "https://github.com/fedoryakubovich/react-awesome-stars-rating/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.umd.config.ts && tsc -p tsconfig.build.json && node scripts/emit-cjs-types.mjs",
    "build:site": "vite build --config vite.site.config.ts",
    "preview": "vite preview",
    "lint": "oxlint .",
    "verify:lint": "node scripts/verify-lint.mjs",
    "format": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "test:next": "node scripts/verify-next.mjs",
    "coverage": "vitest run --coverage",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-release-notes.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:site": "playwright test --config playwright.deployed.config.ts",
    "lint:package": "publint && attw --pack",
    "size": "size-limit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "prepack": "npm run build && npm run verify:package",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rimraf dist dist-site"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@size-limit/file": "^13.0.3",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-commits-filter": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "formik": "^2.4.9",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "sigstore": "^5.0.0",
    "size-limit": "^13.0.3",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "size-limit": [
    {
      "name": "ESM entry",
      "path": "dist/index.mjs",
      "limit": "3 kB",
      "gzip": true
    },
    {
      "name": "CJS entry",
      "path": "dist/index.cjs",
      "limit": "3.05 kB",
      "gzip": true
    },
    {
      "name": "UMD bundle",
      "path": "dist/index.umd.cjs",
      "limit": "3.1 kB",
      "gzip": true
    }
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,css,md,yml,yaml,html}": "oxfmt --write"
  }
}
