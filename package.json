{
  "name": "react-awesome-stars-rating",
  "version": "1.0.0",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "awesome",
    "stars",
    "star",
    "rating"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fedoryakubovich/react-awesome-stars-rating"
  },
  "author": "Fedor Yakubovich",
  "bugs": {
    "url": "https://github.com/fedoryakubovich/react-awesome-stars-rating/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:site": "vite build --config vite.site.config.ts",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@storybook/addon-a11y": "^10.2.13",
    "@storybook/addon-links": "^10.2.13",
    "@storybook/react-vite": "^10.2.13",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-form": "^1.28.0",
    "@testing-library/dom": "^10.3.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.9.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "10.2.13",
    "formik": "^2.4.6",
    "husky": "^9.1.6",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.1",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.50.1",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.3",
    "storybook": "^10.2.13",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write",
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  }
}
