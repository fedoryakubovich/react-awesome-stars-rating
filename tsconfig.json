{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src",
    "e2e",
    "e2e-deployed",
    ".storybook",
    "playwright.config.ts",
    "playwright.deployed.config.ts",
    "vite.config.ts",
    "vite.site.config.ts",
    "vite.umd.config.ts"
  ]
}
